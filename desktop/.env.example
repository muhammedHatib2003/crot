# Optional overrides for the desktop shell itself.
# (The web UI's API URL is set via web/.env -> VITE_API_URL when building.)

# URL the Electron dev shell will load while developing.
# Defaults to http://localhost:5173 (the Vite dev server).
ELECTRON_DEV_URL=http://localhost:5173

# Port the embedded local HTTP server uses in production builds
# to serve the bundled web assets. The renderer's Origin becomes
# http://localhost:<this-port>, which you can whitelist via the
# API's CLIENT_ORIGINS env so CORS works against the Render backend.
ELECTRON_LOCAL_PORT=5174
