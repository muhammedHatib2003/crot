# API base URL.
# Local development:
#   VITE_API_URL=http://localhost:4000
# Production (Render) — root URL only, no /api/public suffix:
#   VITE_API_URL=https://crot.onrender.com
#
# The app automatically appends "/api" if missing.
VITE_API_URL=http://localhost:4000

# Optional override for table QR links (no trailing slash).
# Normally the owner panel reads publicAppUrl from the API (CLIENT_ORIGINS / PUBLIC_APP_URL in api/.env).
# VITE_PUBLIC_APP_URL=https://your-app.vercel.app
