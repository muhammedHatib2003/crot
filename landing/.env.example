# Landing site demo links (optional — sensible defaults baked into the code).
# All values are URLs the marketing site points to; not touching the backend.

# Public web app (Owner / Cashier / Kitchen entry — usually the Vercel deployment URL).
VITE_APP_URL=https://app.crot.example

# Direct deep-links (default to VITE_APP_URL + path if you leave them blank).
VITE_OWNER_URL=
VITE_ADMIN_URL=
VITE_KITCHEN_URL=
VITE_CASHIER_URL=
VITE_ONLINE_ORDER_URL=

# Optional GitHub / docs links shown in the navbar / footer.
VITE_GITHUB_URL=
VITE_DOCS_URL=
